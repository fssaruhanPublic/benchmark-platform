<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BenchmarkPlatform.Core\BenchmarkPlatform.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Microsoft.Data.SqlClient (SQL Server provider) refuses to run in invariant mode, which
         Directory.Build.props turns on for everything else. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
